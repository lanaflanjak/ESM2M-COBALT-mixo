#!/bin/bash

# AFW2024
# Makes new fields for CFCs starting from the end of landuse spinup
# NOTE: Updating to COBALTv2 & MOM6 CFCs:  cfc_* --> cfc*

## ocean_cfc.res.nc:

# Extract only the 'temp' variable from the original file
ncks -v temp ocean_temp_salt.res.nc temp.nc

# Use ncap2 to create new variables based on 'temp' but multiplied by 0.0
ncap2 -O -s 'cfc11=temp*0.0' temp.nc ocean_cfc.res.nc
ncap2 -O -s 'cfc12=temp*0.0' ocean_cfc.res.nc ocean_cfc.res.nc
ncap2 -O -s 'cfc113=temp*0.0' ocean_cfc.res.nc ocean_cfc.res.nc
ncap2 -O -s 'cfc22=temp*0.0' ocean_cfc.res.nc ocean_cfc.res.nc

# Remove the 'temp' variable
ncks -O -x -v temp ocean_cfc.res.nc ocean_cfc.res.nc

# Remove the temporary file
rm temp.nc




