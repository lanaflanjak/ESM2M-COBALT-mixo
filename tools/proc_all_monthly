#!/bin/bash

files=$1 #'*zoo*' #$(ls *.nc)
check='false'


# Loop over all directories in the current OUTPUT directory
cd ./OUTPUT
for dir in */; do
  # If the "annual" directory does not exist in the current directory
  #if [ ! -d "${dir}/annual" ]; then
  if [ "$check" = "false" ] || [ ! -d "${dir}/annual" ]; then
  cd "${dir}"
    bash ~/ESM2M/tools/monthly_to_annual ${files}
    # Change back to the original directory
    cd -
  fi
done
cd ../

